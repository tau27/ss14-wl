<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client._WL.Research.UI"
    Title="ПЕРЕНОС ДАННЫХ"
    MinSize="550 350">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="10">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" HorizontalAlignment="Center" Margin="10">
            <ui:DataStorageControl Name="DataStorageCard" />
        </BoxContainer>
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="10">
            <PanelContainer VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#000000" BorderColor="#3B3E56" BorderThickness="3" />
                    </PanelContainer.PanelOverride>
                <BoxContainer SizeFlagsStretchRatio="3"
                              Orientation="Horizontal"
                              HorizontalExpand="True"
                              VerticalExpand="True"
                              Margin="8">
                    <BoxContainer Name="StoragePoints" SizeFlagsStretchRatio="3" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                        <Label Text="10 очко" HorizontalExpand="True" MinWidth="120"/>
                    </BoxContainer>
                    <BoxContainer Name="PointsSpins" SizeFlagsStretchRatio="3" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                        <SpinBox Name="Amount"
                                 Access="Public"
                                 HorizontalExpand="True"
                                 Value="0"
                                 MaxWidth="120"/>
                    </BoxContainer>
                    <BoxContainer Name="DiskPoints" SizeFlagsStretchRatio="3" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                        <Label Text="10 очко" HorizontalExpand="True" MinWidth="120"/>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
                <Control MinWidth="10"/>
                <BoxContainer SizeFlagsStretchRatio="3" Orientation="Vertical" HorizontalExpand="True" >
                    <BoxContainer SizeFlagsStretchRatio="3" Orientation="Horizontal" HorizontalAlignment="Center" HorizontalExpand="True" >
                        <Button Name="ButtonMinimum" StyleClasses="OpenRight" Text="Minimum" MaxWidth="150" />
                        <Button Name="ButtonMaximum" StyleClasses="OpenBoth" Text="Максимум" MaxWidth="150" />
                        <Button Name="ButtonTransfer" Text="Перевод" MaxWidth="150" />
                    </BoxContainer>
                    <BoxContainer SizeFlagsStretchRatio="3" HorizontalAlignment="Center" Orientation="Vertical" HorizontalExpand="True">
                        <Label Text="С диска" HorizontalExpand="True"
                                        StyleClasses="highlight" MinWidth="120"/>
                        <controls:SwitchButton Name="BreakerButton" MinWidth="150"/>
                        <Label Text="На диск" HorizontalExpand="True"
                                        StyleClasses="highlight" MinWidth="120"/>
                    </BoxContainer>
                </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
